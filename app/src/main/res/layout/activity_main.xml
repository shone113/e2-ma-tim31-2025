<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/background_light"
    tools:context=".presentation.ui.MainActivity">

    <!-- Status Bar Include -->
    <include
        android:id="@+id/statusBarView"
        layout="@layout/view_status_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingTop="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Grid of Buttons -->
    <GridLayout
        android:id="@+id/homeGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="2"
        android:rowCount="4"
        android:padding="16dp"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/statusBarView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Task Calendar -->
        <LinearLayout
            android:id="@+id/btnTaskCalendar"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_month"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Task Calendar"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Shop -->
        <LinearLayout
            android:id="@+id/btnShop"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_gallery"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shop"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- New Task -->
        <LinearLayout
            android:id="@+id/btnNewTask"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_input_add"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Task"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Battle -->
        <LinearLayout
            android:id="@+id/btnBattle"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_compass"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Battle"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Categories -->
        <LinearLayout
            android:id="@+id/btnCategories"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categories"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- All Users -->
        <LinearLayout
            android:id="@+id/btnAllUsers"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_myplaces"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Users"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Special Mission -->
        <LinearLayout
            android:id="@+id/btnSpecMission"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_compass"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Special Mission View"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/btnActSpecMission"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@android:drawable/ic_menu_compass"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Special Mission"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- LogOut button -->
        <LinearLayout
            android:id="@+id/btnLogOut"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@drawable/logout"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log out"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Profile button -->
        <LinearLayout
            android:id="@+id/btnMyProfile"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@android:drawable/btn_default"
            android:padding="16dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1">

            <ImageView
                android:src="@drawable/user"
                android:layout_width="48dp"
                android:layout_height="48dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My profile"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </GridLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
